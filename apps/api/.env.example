# API — copie para .env (dev local). Em homolog/prod as variáveis vêm de infra/env/*.env
APP_ENV=dev
PORT=4000
# Origem pública do front: base dos links de e-mail e do certificado (obrigatória em homolog/prod)
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://levelusp:levelusp@localhost:5432/levelusp_dev
RUNNER_URL=http://localhost:8081
RUNNER_TOKEN=troque-por-um-segredo-com-24-caracteres
UPLOAD_DIR=./data/uploads
LOG_LEVEL=debug
# E-mail (opcional em dev; sem SMTP_URL o conteúdo vai para o log). Teste: pnpm --filter @levelusp/api mail:test voce@exemplo.com
# SMTP_URL=smtp://usuario:senha@smtp.exemplo.com:587
# MAIL_FROM=LevelUSP <nao-responda@exemplo.com>
# SMTP_REQUIRE_TLS=true
