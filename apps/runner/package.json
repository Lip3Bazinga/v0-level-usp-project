{
  "name": "@levelusp/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Executor isolado: roda código Python dos alunos em CPython 3.14 WASI (Wasmtime) e, para lições python-dados, em Pyodide (numpy, pandas, scikit-learn) dentro de workers do Node; opcionalmente (python-completo, desligado por padrão), em CPython nativo com PyTorch em contêineres gVisor de uso único. Sem segredos, sem banco, sem rede.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts src/pyodide-worker.ts --format esm --clean --target node22",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:attacks": "vitest run --config test/attacks/vitest.config.ts",
    "setup:python": "bash scripts/fetch-python-wasi.sh",
    "setup:pyodide": "bash scripts/fetch-pyodide.sh"
  },
  "dependencies": {
    "@levelusp/contracts": "workspace:*",
    "pyodide": "314.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@levelusp/eslint-config": "workspace:*",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^22.15.0",
    "eslint": "^9.37.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
