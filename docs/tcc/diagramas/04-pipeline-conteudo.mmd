%% Pipeline de conteúdo: .lvl.md -> check -> build -> verify -> pacote -> importação.
%% Rastreabilidade de cada caixa e seta: docs/tcc/diagramas/rastreabilidade.md, seção 04.
%% Linha cheia = dependência de dados. Linha tracejada = o passo executa código no runner real
%% ou é um portão de qualidade pela convenção da equipe (nenhum job do CI roda content:verify).
flowchart LR
  FONTE["content/ (texto versionado)<br/>trilhas/*.yaml, cursos/CURSO/curso.yaml, prova.yaml,<br/>MODULO/modulo.yaml, MODULO/NN-slug.lvl.md, MODULO/assets/"]

  subgraph AUTORIA["Máquina do autor ou CI (apps/api/scripts)"]
    CHECK["1. pnpm content:check<br/>compileContent + lintContent<br/>NÃO executa código"]
    BUILD["2. pnpm content:build<br/>compileContent + lintContent<br/>+ gera saída dos passos Previsão<br/>+ validateBundle (contentBundleSchema)"]
    VERIFY["3. pnpm content:verify<br/>solução APROVA, código inicial REPROVA,<br/>cada solução errada REPROVA,<br/>previsões e blocos visualizar rodam"]
  end

  RUNNER["runner real<br/>(RUNNER_URL, RUNNER_TOKEN)<br/>mesmo motor de correção da API:<br/>buildProbes + grade"]

  PACOTE[["4. Pacote formato 2<br/>packages/db/seed/trilha-python-ia.json<br/>(traz gabaritos e wrong_solutions: wrong_solutions nunca é gravada no banco)"]]

  subgraph IMPORTACAO["5. Importação (upsert por slug, uma transação, ids preservados)"]
    SEED["pnpm db:seed<br/>seed.ts -> importContentBundle"]
    ADMIN["POST /api/admin/content/import (papel admin)<br/>ContentController -> ContentService -> importContentBundle"]
  end

  BANCO[("PostgreSQL 17<br/>cursos, módulos, lições, passos,<br/>trilhas, content_assets")]

  FONTE --> CHECK
  CHECK -- "sem problemas" --> BUILD
  BUILD -- "pacote validado" --> PACOTE
  FONTE -. "compila de novo em memória" .-> VERIFY
  BUILD -. "só lições com Previsão" .-> RUNNER
  VERIFY -. "job com sondas, por passo" .-> RUNNER
  VERIFY -. "portão manual antes de importar" .-> PACOTE
  PACOTE --> SEED
  PACOTE --> ADMIN
  SEED --> BANCO
  ADMIN --> BANCO
