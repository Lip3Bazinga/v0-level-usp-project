@startuml component-overview
' Visão de componentes do LevelUSP
' Renderize com a extensão PlantUML do VS Code ou em plantuml.com

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
title LevelUSP — Visão de Componentes

actor "Aluno / Professor / Admin" as User

package "Navegador" {
  [Next.js App\n(React 19, App Router)] as App
  [use-python (hook)] as Hook
  [pyodide-worker-v2.js\n(Web Worker)] as Worker
  [CodeMirror\n(editor)] as Editor
  App --> Editor
  App --> Hook
  Hook ..> Worker : postMessage
}

package "Vercel" {
  [Middleware (Edge)\nsessão + RBAC] as MW
  [Route Handler\n/auth/callback] as CB
}

package "Supabase" {
  database "PostgreSQL 17\n+ RLS" as DB
  [Auth (GoTrue)] as Auth
  [RPC\naward_xp / reorder_lessons] as RPC
  [Storage\ncourse-covers] as Storage
}

cloud "jsDelivr CDN\nPyodide (WASM)" as CDN
cloud "Google / GitHub\nOAuth" as OAuth

User --> App
App --> MW : navegação
App --> Auth : @supabase/ssr
App --> DB : queries (RLS)
App --> RPC : rpc()
App --> Storage : upload de capas
Worker --> CDN : importScripts
MW --> Auth
MW --> DB : checa role
CB --> Auth : exchangeCodeForSession
Auth --> OAuth

note right of Worker
  Execução Python ocorre
  100% no cliente.
  Servidor/banco não
  executam código do aluno.
end note

@enduml
