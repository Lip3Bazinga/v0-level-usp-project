@startuml evaluation-sequence
' Sequência de avaliação de código do aluno
title LevelUSP — Avaliação de Código (Verificar Resposta)

skinparam shadowing false
autonumber

actor Aluno
participant "lesson/[id]/page.tsx" as Page
participant "use-python" as Hook
participant "Web Worker\n(Pyodide)" as Worker
database "Supabase" as DB

Aluno -> Page : escreve código + clica "Verificar"
Page -> Hook : execute(code, {testCode: hidden_tests})
Hook -> Worker : postMessage("execute")

activate Worker
Worker -> Worker : executa código do aluno (namespace _ns)
Worker -> Worker : captura stdout/stderr + figuras
alt erro de execução
  Worker --> Hook : execution-error
  Hook --> Page : onError (traduzido p/ pt-BR)
else sem erro e há testCode
  Worker -> Worker : detectUnittest()?
  alt unittest
    Worker -> Worker : TextTestRunner sobre _ns
  else assert
    Worker -> Worker : exec dos asserts sobre _ns
  end
  Worker --> Hook : test-result {allPassed, testsRun, failureDetails}
end
deactivate Worker

Hook --> Page : onTestResult(result)

alt allPassed
  Page -> DB : awardXp(user, lesson, xp) [RPC]
  DB -> DB : upsert lesson_progress + soma XP + recalcula nível
  Page -> DB : refreshProfile()
  DB --> Page : perfil atualizado
  Page -> Aluno : SuccessFeedback (+XP, confete)
  opt subiu de nível
    Page -> Aluno : LevelUpModal
  end
else falha
  Page -> Aluno : feedback de falha + dicas
end

note over Worker
  Limitação conhecida: aluno e testes
  compartilham o namespace _ns (ver doc 05).
end note

@enduml