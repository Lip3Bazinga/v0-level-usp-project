# LevelUSP — produção numa VM Linux. Modelo de infra/env/vm.env (NUNCA versionar o .env real).
#   infra/scripts/levelusp-vm.sh setup   → copia este arquivo, gera as senhas e aplica chmod 600
# Valores "__gerar__" são preenchidos pelo setup; "__preencher__" você completa à mão.
# Formato: KEY=VALOR, uma por linha, sem aspas nem espaços em volta do "=". Linhas com # são comentários.
# Guia completo: docs/v2/producao-vm.md

# --------------------------------------------------------------------------- Identidade
APP_ENV=prod
# Nome do projeto compose (prefixo de contêineres, redes e volumes). Não mude depois do primeiro deploy.
COMPOSE_PROJECT_NAME=levelusp-prod

# --------------------------------------------------------------------------- Imagens (GHCR)
# Publicadas pelo CD do GitHub. Use "prod" (última aprovada em main) ou "sha-<7 primeiros do commit>"
# para fixar uma versão. `levelusp-vm.sh deploy <tag>` e `rollback <sha>` atualizam este valor.
REGISTRY=ghcr.io/lip3bazinga/levelusp
IMAGE_TAG=prod

# --------------------------------------------------------------------------- Endereço público
# Origem que alunos digitam no navegador: links de e-mail, PDF do certificado, verificação, Open Graph.
# Só esquema + domínio (sem barra final, sem caminho). Em prod precisa ser https.
PUBLIC_BASE_URL=https://__preencher__
# Entrada pública: cloudflare (túnel nomeado, nenhuma porta aberta) | caddy (HTTPS próprio, portas 80/443) | none
INGRESS=cloudflare
# INGRESS=cloudflare: token do túnel (Zero Trust → Networks → Tunnels → seu túnel → "Install connector").
# No painel, o "Public hostname" deve apontar para o serviço http://web:3000.
CLOUDFLARE_TUNNEL_TOKEN=
# INGRESS=caddy: domínio (o mesmo de PUBLIC_BASE_URL, sem https://) e e-mail para avisos do Let's Encrypt.
PUBLIC_DOMAIN=
ACME_EMAIL=
# Porta local do front (só 127.0.0.1; usada pelo health-check local e para depuração via túnel SSH).
WEB_PORT=3000

# --------------------------------------------------------------------------- Segredos (gerados pelo setup)
POSTGRES_PASSWORD=__gerar__
RUNNER_TOKEN=__gerar__

# --------------------------------------------------------------------------- Aplicação
# Cadastro aberto (true) ou só por convite do admin (false).
SIGNUP_ENABLED=true
LOG_LEVEL=info

# --------------------------------------------------------------------------- E-mail (SMTP)
# smtp://usuario:senha@host:587 (STARTTLS) ou smtps://usuario:senha@host:465 (TLS direto).
# Caracteres especiais na senha precisam de percent-encoding (@ → %40, : → %3A, / → %2F).
# Vazio: os e-mails (links de senha/convite) vão só para o log da API.
SMTP_URL=
# Remetente; o domínio deve ter SPF/DKIM do provedor SMTP, senão cai no spam.
MAIL_FROM=LevelUSP <nao-responda@__preencher__>
# Recusa enviar em smtp:// se o servidor não oferecer STARTTLS.
SMTP_REQUIRE_TLS=true
# Tempo-limite de cada etapa da conexão SMTP e tentativas em falhas temporárias.
SMTP_TIMEOUT_MS=15000
MAIL_MAX_ATTEMPTS=3

# --------------------------------------------------------------------------- Seed inicial (só no primeiro deploy)
# Produção: só admin e badges (o conteúdo real vem da importação do Supabase).
SEED_CONTENT=false
SEED_DEMO_USERS=false
SEED_ADMIN_EMAIL=__preencher__
SEED_ADMIN_PASSWORD=__gerar__

# --------------------------------------------------------------------------- Recursos (padrão: 2 vCPU / 4 GB)
# Tetos por contêiner (cpus em núcleos; memória com sufixo m/g). Tabela para 4 vCPU / 8 GB no guia.
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1g
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAX_CONNECTIONS=50
API_CPUS=1.0
API_MEMORY=768m
API_HEAP_MB=512
DATABASE_POOL_MAX=10
WEB_CPUS=1.0
WEB_MEMORY=512m
WEB_HEAP_MB=384
RUNNER_CPUS=1.5
RUNNER_MEMORY=1g
# Execuções Python simultâneas no executor (cada uma até 128 MB): uma por vCPU da VM.
RUNNER_CONCURRENCY=2
# Espera estimada máxima na fila do Verificar antes de responder "ocupado, tente em N s" (ms).
RUNNER_MAX_QUEUE_WAIT_MS=20000
# Keep-alive da web acima do proxy da frente (cloudflared 90 s, Caddy 120 s), em ms.
WEB_KEEP_ALIVE_TIMEOUT_MS=125000
# Rotação dos logs dos contêineres (por contêiner: até LOG_MAX_SIZE × LOG_MAX_FILE).
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
# Imagens de terceiros (fixe versões; atualize de propósito).
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2025.9.1
CADDY_IMAGE=caddy:2.10.2-alpine

# --------------------------------------------------------------------------- Backups (infra/scripts/backup.sh)
# Pasta no host (fora do repositório; o script aplica chmod 700). Use um disco com espaço para ~15 backups.
BACKUP_DIR=/var/backups/levelusp
# compose: pg_dump dentro do contêiner postgres (padrão) | direct: pg_dump do host (PGHOST/PGUSER/PGPASSWORD)
BACKUP_MODE=compose
# Rotação: 7 diários, 4 semanais (cópia do diário no dia BACKUP_WEEKLY_DAY: 1=seg … 7=dom), 10 manuais.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MANUAL=10
BACKUP_WEEKLY_DAY=7
# Criptografia em repouso: none | age (recomendado: chave pública na VM) | gpg (senha simétrica em arquivo).
BACKUP_ENCRYPTION=none
# age: chave PÚBLICA (age1…) ou arquivo com uma por linha; a chave PRIVADA fica guardada fora da VM
# (cofre de senhas/papel). Para o teste automático de restauração, a privada também precisa estar na VM
# (arquivo root 600) — ver a seção "Backups" do guia.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_RECIPIENTS_FILE=
BACKUP_AGE_IDENTITY_FILE=
# gpg: arquivo (root 600) com a senha; guarde uma cópia da senha fora da VM.
BACKUP_GPG_PASSPHRASE_FILE=
# Cópia externa (desligada por padrão; só aceita backups cifrados):
#   rclone: remoto já configurado com `rclone config` (ex.: usp-drive:levelusp-backups)
BACKUP_RCLONE_REMOTE=
#   Idade máxima no remoto (ex.: 35d); vazio = não apaga nada lá.
BACKUP_RCLONE_MAX_AGE=
#   Ou um script seu (recebe: <pasta-do-backup> <caminho-relativo>), ex.: scp para outro servidor.
BACKUP_OFFSITE_HOOK=
BACKUP_OFFSITE_ALLOW_PLAINTEXT=false
# Banco descartável do teste semanal de restauração (criado e apagado pelo script).
RESTORE_TEST_DB=levelusp_restore_test

# --------------------------------------------------------------------------- Monitoramento
# Pasta dos logs de cron (health-check, backup, teste de restauração).
LOG_DIR=/var/log/levelusp
# Alerta em texto puro via POST (ex.: https://ntfy.sh/<tópico-secreto>). Vazio = sem alerta.
ALERT_WEBHOOK_URL=
# Falhas seguidas do health-check local antes de alertar (cron a cada 5 min → 2 = ~10 min).
HEALTHCHECK_FAILURES_BEFORE_ALERT=2
# Também testar a URL pública (passa pelo túnel/Caddy e pela internet).
HEALTHCHECK_PUBLIC=true
# "Dead man's switch" opcional (ex.: Healthchecks.io): o script pinga a URL no sucesso e URL/fail na falha.
HEALTHCHECK_PING_URL=
BACKUP_PING_URL=
RESTORE_TEST_PING_URL=
