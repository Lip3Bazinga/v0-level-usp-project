# Produção — copie para prod.env (ou rode: levelusp.ps1 setup -Env prod, que gera os segredos)
APP_ENV=prod
COMPOSE_PROJECT_NAME=levelusp-prod
IMAGE_TAG=prod
REGISTRY=ghcr.io/lip3bazinga/levelusp
WEB_PORT=3000
# Preenchido automaticamente com o endereço do Cloudflare Quick Tunnel
APP_ORIGIN=http://localhost:3000
POSTGRES_PASSWORD=__gerar__
RUNNER_TOKEN=__gerar__
SIGNUP_ENABLED=true
LOG_LEVEL=info
BACKUP_DIR=./backups/prod
# Seed de produção: só admin e badges (conteúdo real vem da importação do Supabase)
SEED_CONTENT=false
SEED_ADMIN_EMAIL=admin@levelusp.dev
SEED_ADMIN_PASSWORD=__gerar__
SEED_DEMO_USERS=false
# Opcional: SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
