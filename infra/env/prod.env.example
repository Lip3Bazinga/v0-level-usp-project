# Produção — copie para prod.env (ou rode: levelusp.ps1 setup -Env prod, que gera os segredos)
APP_ENV=prod
COMPOSE_PROJECT_NAME=levelusp-prod
IMAGE_TAG=prod
REGISTRY=ghcr.io/lip3bazinga/levelusp
WEB_PORT=3000
# Preenchido automaticamente com o endereço do Cloudflare Quick Tunnel (usado se PUBLIC_BASE_URL estiver vazia).
# Produção na VM com domínio fixo: infra/env/vm.env.example e docs/v2/producao-vm.md
APP_ORIGIN=http://localhost:3000
POSTGRES_PASSWORD=__gerar__
RUNNER_TOKEN=__gerar__
SIGNUP_ENABLED=true
LOG_LEVEL=info
# Executor: memória do contêiner e admissão de lotes por memória. Um worker do Pyodide ocupa
# ≈ 0,25 GiB (perfil dados) ou ≈ 1,2 GiB (perfil ml); o executor só inicia um lote quando o
# worker cabe em RUNNER_MEMORY − RUNNER_MEMORY_RESERVE_MB (sem memória: fila ou 503, nunca OOM).
# Lições ml exigem RUNNER_MEMORY de 2g ou mais (cada 1,2 GiB a mais = +1 lote ml simultâneo).
RUNNER_MEMORY=2g
# RUNNER_MEMORY_RESERVE_MB=512
# RUNNER_BATCH_MEMORY_MB=python:0,dados:256,ml:1229
# Política do Pyodide por perfil: dados com worker novo a cada lote; ml com worker reaproveitado
# (restaurado entre lotes), para o envio ml não pagar ~9,5 s de aquecimento toda vez.
RUNNER_PYODIDE_POLICY=dados:fresh,ml:reuse
RUNNER_PYODIDE_WARM=dados:1,ml:0
BACKUP_DIR=./backups/prod
# Seed de produção: só admin e badges (conteúdo real vem da importação do Supabase)
SEED_CONTENT=false
SEED_ADMIN_EMAIL=admin@levelusp.dev
SEED_ADMIN_PASSWORD=__gerar__
SEED_DEMO_USERS=false
# Opcional: SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
