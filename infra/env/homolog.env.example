# Homologação — copie para homolog.env (ou rode: levelusp.ps1 setup -Env homolog, que gera os segredos)
APP_ENV=homolog
COMPOSE_PROJECT_NAME=levelusp-homolog
IMAGE_TAG=homolog
REGISTRY=ghcr.io/lip3bazinga/levelusp
WEB_PORT=3001
# Preenchido automaticamente com o endereço do Cloudflare Quick Tunnel
APP_ORIGIN=http://localhost:3001
POSTGRES_PASSWORD=__gerar__
RUNNER_TOKEN=__gerar__
SIGNUP_ENABLED=true
LOG_LEVEL=info
BACKUP_DIR=./backups/homolog
# Seed de homologação (usuários de demonstração + curso Python Completo)
SEED_ADMIN_EMAIL=admin@levelusp.dev
SEED_ADMIN_PASSWORD=__gerar__
SEED_DEMO_USERS=true
# Opcional: SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
