{
  "name": "levelusp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "db:generate": "pnpm --filter @levelusp/db generate",
    "db:migrate": "pnpm --filter @levelusp/db migrate",
    "db:seed": "pnpm --filter @levelusp/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.8",
    "typescript": "5.9.3"
  }
}
